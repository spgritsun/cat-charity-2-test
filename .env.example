# Пример файла с переменными окружения.
# Скопируйте его в .env и подставьте свои значения:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# Файл .env в репозиторий не попадает — он перечислен в .gitignore.

# Название и описание приложения, отображаются в документации Swagger.
# Значения с пробелами берите в одинарные кавычки.
APP_TITLE='Благотворительный фонд поддержки котиков QRKot'
DESCRIPTION='Сервис для поддержки котиков'

# Строка подключения к базе данных.
DATABASE_URL=sqlite+aiosqlite:///./qrkot.db

# Секретный ключ для подписи JWT-токенов.
# В рабочем окружении задайте длинную случайную строку, например:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET=CHANGE_ME

# Учётные данные первого суперпользователя.
# Если обе переменные заданы, он создаётся при старте приложения.
# Если хотя бы одна не задана — суперпользователь не создаётся.
# Пароль со спецсимволами ($, пробелы) обязательно в одинарных кавычках.
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD='CHANGE_ME'
